APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Frontend -> API wiring
VITE_API_BASE_URL="/api"
VITE_API_PROXY_TARGET="http://127.0.0.1:3001"

# Meta Embedded Signup (frontend)
VITE_META_APP_ID="797649033413847"
VITE_META_WHATSAPP_ONBOARDING_CONFIG_ID="959911236622056"
VITE_META_INSTAGRAM_INBOX_CONFIG_ID="1851191622215671"
VITE_META_ADS_CONFIG_ID="356104403242812"
VITE_META_CATALOG_CONFIG_ID="1644345003439852"
VITE_META_MESSENGER_CONFIG_ID="1238854098066248"
VITE_META_LEAD_CAPTURE_CONFIG_ID="1347031370653731"
VITE_META_GRAPH_VERSION="v25.0"

# Meta Graph + webhook (server)
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_GRAPH_VERSION="v25.0"
META_OBA_GRAPH_VERSION="v25.0"
INSTAGRAM_APP_ID="YOUR_INSTAGRAM_APP_ID"
INSTAGRAM_APP_SECRET="YOUR_INSTAGRAM_APP_SECRET"
META_REDIRECT_URI="https://your-domain.com"
META_WEBHOOK_VERIFY_TOKEN="YOUR_META_WEBHOOK_VERIFY_TOKEN"
# Optional override if Messenger should use a different webhook verify token than the shared Meta webhook.
MESSENGER_WEBHOOK_VERIFY_TOKEN=""
# Optional override if Instagram should use a different webhook verify token than Messenger/shared Meta.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
META_TOKEN_ENCRYPTION_KEY="A_LONG_RANDOM_SECRET_FOR_ENCRYPTING_ACCESS_TOKENS"
FRONTEND_ORIGIN="http://localhost:3000"

# Razorpay subscriptions
# Test/live key pair used by the API server to create plans and subscriptions.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
# Secret you set while creating the Razorpay Dashboard webhook.
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# Optional checkout branding
RAZORPAY_BRAND_NAME="Connektly"
RAZORPAY_BRAND_LOGO_URL="https://your-domain.com/logo.png"
WALLET_PRICING_OVERVIEW_URL="https://pricing.connektly.in"

# Trial and long-running subscription counts
RAZORPAY_TRIAL_DAYS="7"
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_MONTHLY="120"
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_ANNUAL="10"

# Optional coupon codes. `percent` values are percentages. `flat` values are rupees off before GST.
# Example:
# RAZORPAY_COUPONS_JSON="{\"WELCOME10\":{\"kind\":\"percent\",\"value\":10,\"description\":\"10% off on the base subscription\"},\"LAUNCH500\":{\"kind\":\"flat\",\"value\":500,\"description\":\"Rs 500 off on the base subscription\"}}"
RAZORPAY_COUPONS_JSON=""

# Wallet and billing rollout
ENABLE_PLATFORM_WALLET="true"
ENABLE_CAMPAIGN_ESTIMATOR="true"
ENABLE_WABA_CREDIT_BILLING="false"
ENABLE_PARTNER_BILLING_MODE="false"
