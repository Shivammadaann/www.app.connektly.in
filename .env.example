# Runtime
NODE_ENV="development"
PORT="3001"
API_PORT=""
FRONTEND_ORIGIN="http://localhost:3000"

# Supabase Configuration
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Optional server aliases if you do not expose VITE_ names to the API runtime.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Frontend -> API wiring
VITE_API_BASE_URL="/api"
VITE_API_PROXY_TARGET="http://127.0.0.1:3001"
DISABLE_HMR="false"

# Turnstile
VITE_TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY"
VITE_TURNSTILE_LOCAL_SITE_KEY=""

# Meta Embedded Signup and Login Configurations
VITE_META_APP_ID="YOUR_META_APP_ID"
VITE_INSTAGRAM_APP_ID=""
VITE_META_INSTAGRAM_INBOX_CONFIG_ID="1851191622215671"
VITE_META_ADS_CONFIG_ID="356104403242812"
VITE_META_CATALOG_CONFIG_ID="1644345003439852"
VITE_META_MESSENGER_CONFIG_ID="1238854098066248"
VITE_META_LEAD_CAPTURE_CONFIG_ID="1347031370653731"
VITE_META_GRAPH_VERSION="v25.0"

# Meta Graph + webhook (server)
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_GRAPH_VERSION="v25.0"
META_OBA_GRAPH_VERSION="v25.0"
INSTAGRAM_APP_ID="YOUR_INSTAGRAM_APP_ID"
INSTAGRAM_APP_SECRET="YOUR_INSTAGRAM_APP_SECRET"
META_REDIRECT_URI="https://your-domain.com/auth/meta/callback"
META_WEBHOOK_VERIFY_TOKEN="YOUR_META_WEBHOOK_VERIFY_TOKEN"
MESSENGER_WEBHOOK_VERIFY_TOKEN=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
META_TOKEN_ENCRYPTION_KEY="A_LONG_RANDOM_SECRET_FOR_ENCRYPTING_ACCESS_TOKENS"
TEMPLATE_HEADER_MEDIA_BUCKET="app-profile-pictures"

# Razorpay subscriptions
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"
RAZORPAY_BRAND_NAME="Connektly"
RAZORPAY_BRAND_LOGO_URL="https://your-domain.com/logo.png"
WALLET_PRICING_OVERVIEW_URL="https://connektly.in/pricing/"
RAZORPAY_TRIAL_DAYS="7"
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_MONTHLY="120"
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_ANNUAL="10"
RAZORPAY_COUPONS_JSON=""

# Wallet and billing rollout
ENABLE_PLATFORM_WALLET="true"
ENABLE_CAMPAIGN_ESTIMATOR="true"
ENABLE_WABA_CREDIT_BILLING="false"
ENABLE_PARTNER_BILLING_MODE="false"
